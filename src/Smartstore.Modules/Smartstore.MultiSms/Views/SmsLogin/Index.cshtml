@model SmsOtpLoginModel

@{
    Layout = "_Layout";
    Assets.AppendTitleParts(T("Plugins.Sms.MultiSms.Otp.LoginTitle").Value);
    Assets.AddMetaRobots();
}

<div class="page login-page">
    <div class="row justify-content-center my-4">
        <div class="col-12 col-md-8 col-xl-6">
            <h1 class="page-title">@T("Plugins.Sms.MultiSms.Otp.LoginTitle")</h1>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted">@T("Plugins.Sms.MultiSms.Otp.LoginHint")</p>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
                    }

                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                    @if (!Model.CodeRequested)
                    {
                        <form asp-controller="SmsLogin" asp-action="RequestCode" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="CheckoutAsGuest" />
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" autofocus required />
                                <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">@T("Plugins.Sms.MultiSms.Otp.SendCode")</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="SmsLogin" asp-action="VerifyCode" method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="CheckoutAsGuest" />
                            <div class="form-floating mb-3">
                                <input asp-for="Phone" class="form-control" inputmode="tel"
                                       autocomplete="tel" placeholder="09123456789" maxlength="16" dir="ltr" readonly />
                                <label asp-for="Phone">@T("Plugins.Sms.MultiSms.Otp.PhoneLabel")</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Code" class="form-control" inputmode="numeric"
                                       autocomplete="one-time-code" placeholder="123456"
                                       pattern="[0-9]{6}" maxlength="6" dir="ltr" autofocus required />
                                <label asp-for="Code">@T("Plugins.Sms.MultiSms.Otp.CodeLabel")</label>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100">@T("Plugins.Sms.MultiSms.Otp.SignIn")</button>
                        </form>
                        <form asp-controller="SmsLogin" asp-action="RequestCode" method="post" class="mt-3">
                            <input type="hidden" name="Phone" value="@Model.Phone" />
                            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                            <input type="hidden" name="CheckoutAsGuest" value="@Model.CheckoutAsGuest" />
                            <button type="submit" class="btn btn-link p-0">@T("Plugins.Sms.MultiSms.Otp.SendCode")</button>
                            <a asp-controller="SmsLogin" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" asp-route-checkoutAsGuest="@Model.CheckoutAsGuest" class="ml-3">@T("Plugins.Sms.MultiSms.Otp.ChangePhone")</a>
                        </form>
                    }
                    <hr />
                    <div class="mt-3 d-flex flex-wrap justify-content-between">
                        <a asp-route="Login" asp-route-method="password" asp-route-returnUrl="@Model.ReturnUrl" asp-route-checkoutAsGuest="@Model.CheckoutAsGuest">@T("Plugins.Sms.MultiSms.Otp.PasswordLogin")</a>
                        <a asp-controller="SmsLogin" asp-action="Enroll">@T("Plugins.Sms.MultiSms.Otp.EnrollLink")</a>
                    </div>
                    <div class="mt-3 d-flex flex-wrap justify-content-between">
                        @if (Model.CheckoutAsGuest)
                        {
                            <a asp-route="Checkout">@T("Account.Login.CheckoutAsGuest")</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
